# Copy to .env and fill from an isolated Stripe sandbox and your Firebase project.
# Never commit .env. Prefer a restricted key (rk_) stored in a secrets vault.
# These placeholders are not keys.

# Stripe (server only). Use a restricted key from an isolated sandbox, not the shared test mode.
STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# One Bracket product, two currency prices: USD 9.99/month and CAD 9.99/month.
STRIPE_PRICE_USD=price_replace_me
STRIPE_PRICE_CAD=price_replace_me
# Latest Endive version verified against the Checkout API reference. Override only to pin.
STRIPE_API_VERSION=2026-10-28.endive

# Public site origin used for Checkout success and cancel URLs. No trailing slash.
PUBLIC_BASE_URL=http://127.0.0.1:8787
PORT=8787

# Comma-separated online features that require a paid subscription.
# Allowed value today: sync
# Empty means nothing is gated. Offline tools cannot be listed here.
PAID_FEATURES=
# Days of access after a renewal payment fails. Access ends at this deadline.
GRACE_DAYS=3
# Extra hour after a paid period ends, so a late renewal webhook does not lock a paying person out.
PAID_BUFFER_HOURS=1

# Firebase. The project id matches config.js. The web apiKey is public; copy it
# from config.js into FIREBASE_WEB_API_KEY. Admin credentials are separate and
# are not in the repo.
FIREBASE_PROJECT_ID=bracket-2b961
FIREBASE_WEB_API_KEY=
# Path to a service account JSON outside the repo, or the JSON itself in a secrets vault.
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/bracket-firebase-admin.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Local emulators only (no cloud project required):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Set to 1 only behind a trusted reverse proxy.
TRUST_PROXY=
# Optional extra allowlist. Signature verification is always required.
# ENFORCE_STRIPE_WEBHOOK_IPS=1
# STRIPE_WEBHOOK_IPS=
