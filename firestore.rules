rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    // Encrypted plan fields only. Billing and entitlement fields are not on this document.
    function planOnly() {
      return request.resource.data.keys().hasOnly(['v', 'salt', 'iter', 'iv', 'z', 'data']);
    }
    function syncGated() {
      return exists(/databases/$(database)/documents/accessPolicy/current)
        && get(/databases/$(database)/documents/accessPolicy/current).data.gatedFeatures.hasAny(['sync']);
    }
    function entitled() {
      let path = /databases/$(database)/documents/entitlements/$(request.auth.uid);
      return exists(path)
        && get(path).data.active == true
        && get(path).data.expiresAt > request.time;
    }
    function canSync() {
      return !syncGated() || entitled();
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && planOnly() && canSync();
      allow delete: if isOwner(userId);
    }

    // Server-written projection. The client may read its own record and cannot grant access.
    match /entitlements/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /profiles/{userId} {
      allow get: if isOwner(userId);
      allow list, create, update, delete: if false;
    }

    // Username ownership, Stripe bindings, processed events, and the paid-feature switch.
    match /usernames/{name} {
      allow read, write: if false;
    }
    match /billing/{userId} {
      allow read, write: if false;
    }
    match /stripeCustomers/{customerId} {
      allow read, write: if false;
    }
    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }
    match /accessPolicy/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
